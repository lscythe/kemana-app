amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["kempt"] {
        fix = "kempt hook"
    }
    ["newlines"] = Builtins.newlines
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["check_merge_conflict"] = Builtins.check_merge_conflict
    ["taplo"] = Builtins.taplo
    // Not Builtins.ryl: its `--diff` check only reports fixable problems, so a duplicate key or a syntax error would pass.
    ["ryl"] {
        glob = List("**/*.yml", "**/*.yaml")
        check = "ryl check {{files}}"
        fix = "ryl check --fix {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ["check-commit-scope"] {
                check = "python3 .github/scripts/commit_scope.py {{commit_msg_file}}"
            }
        }
    }
    ["pre-push"] {
        steps = new Mapping<String, Step> {
            ["check-and-test"] {
                check = "mise run check && mise run test"
            }
        }
    }
}
